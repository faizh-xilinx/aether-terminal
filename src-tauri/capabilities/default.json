{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the Aether main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:event:default",
    "core:menu:default",
    "core:tray:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "opener:allow-open-url",
    "os:default",
    "shell:default"
  ]
}
